#: panel-plugin/caffeine.c:502
msgid "Caffeine: failed to inhibit screensaver/power manager (DBus error)"
msgstr "Caffeine: スクリーンセーバー/電源管理を抑止できませんでした (DBus エラー)"

#: panel-plugin/caffeine.c:515
msgid "Caffeine: ON — screen will stay awake (click to disable)"
msgstr "Caffeine: オン — 画面はオンのままになります (クリックで無効化)"

#: panel-plugin/caffeine.c:532 panel-plugin/caffeine.c:763
msgid "Caffeine: OFF — click to keep the screen awake"
msgstr "Caffeine: オフ — クリックして画面をオンのままにする"

#: panel-plugin/caffeine-prefs.c:181
msgid ""
"Uses the Caffeine icons of your current icon theme. If the theme doesn't "
"provide them, Caffeine's own icons are used instead."
msgstr ""
"現在のアイコンテーマの Caffeine アイコンを使用します。テーマに含まれていない場合は、代わりに Caffeine 独自のアイコンを使用します。"

#: panel-plugin/caffeine-prefs.c:184
msgid ""
"Always uses the icons bundled with Caffeine (or your own PNGs in "
"~/.config/xfce4-caffeine-plugin/icons)."
msgstr ""
"常に Caffeine に同梱されているアイコン (または ~/.config/xfce4-caffeine-plugin/icons にある独自の "
"PNG) を使用します。"

#: panel-plugin/caffeine-prefs.c:189
msgid "It's recommended to pick the theme that matches your system."
msgstr "システムに合ったテーマを選ぶことをお勧めします。"

#: panel-plugin/caffeine-prefs.c:259
msgid "Caffeine Preferences"
msgstr "Caffeine の設定"

#: panel-plugin/caffeine-prefs.c:262
msgid "_Cancel"
msgstr "キャンセル(_C)"

#: panel-plugin/caffeine-prefs.c:263
msgid "_OK"
msgstr "OK(_O)"

#: panel-plugin/caffeine-prefs.c:286
msgid ""
"While Caffeine is on, automatically lock the\n"
"screen and blank the monitor every:"
msgstr ""
"Caffeine がオンの間、次の間隔で自動的に画面を\n"
"ロックしてモニターを消灯する:"

#: panel-plugin/caffeine-prefs.c:290
msgid "Never (stay awake indefinitely)"
msgstr "しない (無期限に画面をオンのままにする)"

#: panel-plugin/caffeine-prefs.c:371
msgid "5 minutes"
msgstr "5 分"

#: panel-plugin/caffeine-prefs.c:375
msgid "10 minutes"
msgstr "10 分"

#: panel-plugin/caffeine-prefs.c:294 panel-plugin/caffeine-prefs.c:379
msgid "15 minutes"
msgstr "15 分"

#: panel-plugin/caffeine-prefs.c:298 panel-plugin/caffeine-prefs.c:383
msgid "30 minutes"
msgstr "30 分"

#: panel-plugin/caffeine-prefs.c:302
msgid "60 minutes"
msgstr "60 分"

#: panel-plugin/caffeine-prefs.c:306 panel-plugin/caffeine-prefs.c:387
msgid "Custom:"
msgstr "カスタム:"

#: panel-plugin/caffeine-prefs.c:315 panel-plugin/caffeine-prefs.c:397
msgid "minutes"
msgstr "分"

#: panel-plugin/caffeine-prefs.c:322
msgid "Panel icons:"
msgstr "パネルアイコン:"

#: panel-plugin/caffeine-prefs.c:326
msgid "Follow system icon theme (default)"
msgstr "システムのアイコンテーマに従う (既定)"

#: panel-plugin/caffeine-prefs.c:331
msgid "Caffeine's own icons"
msgstr "Caffeine 独自のアイコン"

#: panel-plugin/caffeine-prefs.c:340
msgid "Icon variant:"
msgstr "アイコンのバリエーション:"

#: panel-plugin/caffeine-prefs.c:344
msgid "Auto (match system theme)"
msgstr "自動 (システムのテーマに合わせる)"

#: panel-plugin/caffeine-prefs.c:349
msgid "Light system theme"
msgstr "ライトなシステムテーマ"

#: panel-plugin/caffeine-prefs.c:354
msgid "Dark system theme"
msgstr "ダークなシステムテーマ"

#: panel-plugin/caffeine-prefs.c:364
msgid "Turn off screen after (does not lock the session)"
msgstr "次の時間が経過したら画面をオフにする (セッションはロックしません)"
